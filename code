# 1. Split letters and numbers
def ex1():
    s = input("Enter a string with letters and numbers: ")
    letters = [c for c in s if c.isalpha()]
    numbers = [int(c) for c in s if c.isdigit()]
    print(f'Word: "{"".join(letters)}", Sum: {sum(numbers)}')


# 2. Password validation
def ex2():
    pw = input("Enter a password: ")
    specials = "@#$%^&*!?"
    ok = (
        8 <= len(pw) <= 16
        and any(c.isupper() for c in pw)
        and any(c in specials for c in pw)
    )
    print("Password is Secure." if ok else "Password is NOT secure.")


# 3. Store discount
def ex3():
    price = float(input("Price: "))
    member = input("Member (Yes/No): ").strip().lower() == "yes"
    if price < 50:
        total = price
    elif price <= 100:
        total = price * 0.90
    else:
        total = price * 0.80
    if member:
        total *= 0.95
    print(f"Final Total: ${total:.2f}")


# 4. Common names
def ex4():
    l1 = [n.strip() for n in input("List 1: ").split(",") if n.strip()]
    l2 = [n.strip() for n in input("List 2: ").split(",") if n.strip()]
    common = [n for n in l1 if n in l2]
    print("Common names:", common)


# 5. Honor roll
def ex5():
    students = {
        "Sam": [95, 90, 92],
        "Mia": [80, 85, 90],
        "Omar": [100, 95, 98],
    }
    for name, scores in students.items():
        avg = sum(scores) / len(scores)
        line = f"{name}: Average {avg:.1f}"
        if avg > 90:
            line += " - Honor Roll"
        print(line)


# 6. Interleave two words
def ex6():
    w1 = input("Word 1: ")
    w2 = input("Word 2: ")
    if len(w1) != len(w2):
        print("Words must be the same length.")
        return
    print("".join(a + b for a, b in zip(w1, w2)))


# 7. Digital root
def ex7():
    n = input("Enter a number: ").strip()
    steps = []
    while len(n) > 1:
        digits = [int(c) for c in n]
        total = sum(digits)
        steps.append(f"{'+'.join(map(str, digits))}={total}")
        n = str(total)
    print(f"Digital Root: {n}" + (f" ({', '.join(steps)})" if steps else ""))


# 8. Frequencies as tuples
def ex8():
    nums = [1, 1, 2, 3, 3, 3, 4]
    result = []
    for x in nums:
        if x not in [t[0] for t in result]:
            result.append((x, nums.count(x)))
    print(result)


# 9. Factorial divisible by sum 1..n
def ex9():
    n = int(input("Enter n (>= 1): "))
    fact = 1
    for i in range(1, n + 1):
        fact *= i
    total = sum(range(1, n + 1))
    verdict = "is" if fact % total == 0 else "is not"
    print(f"Factorial is {fact}, Sum is {total}. {fact} {verdict} divisible by {total}.")


# 10. Shopping cart
def ex10():
    store = {"apple": 0.5, "bread": 2.0, "milk": 1.5}
    cart = []
    print("Items:", store)
    print("Commands: add <item>, remove <item>, done")
    while True:
        cmd = input("> ").strip().lower().split()
        if not cmd:
            continue
        if cmd[0] == "done":
            break
        if len(cmd) != 2 or cmd[0] not in ("add", "remove"):
            print("Error: use 'add <item>', 'remove <item>' or 'done'.")
            continue
        action, item = cmd
        if item not in store:
            print(f"Error: '{item}' is not in the store.")
        elif action == "add":
            cart.append(item)
        elif item in cart:
            cart.remove(item)
        else:
            print(f"Error: '{item}' is not in your cart.")
    print(f"Total Bill: ${sum(store[i] for i in cart):.1f}")


# 11. Sentence palindrome
def ex11():
    s = input("Sentence: ")
    cleaned = s.replace(" ", "").lower()
    print(cleaned == cleaned[::-1])


# 12. Number square
def ex12():
    n = int(input("n = "))
    for row in range(1, n + 1):
        print(" ".join([str(row)] * n))


# 13. Peaks
def ex13():
    nums = [1, 5, 2, 6, 3]
    peaks = [nums[i] for i in range(1, len(nums) - 1)
             if nums[i] > nums[i - 1] and nums[i] > nums[i + 1]]
    print("Peaks:", peaks)


# 14. Flip dictionary
def ex14():
    d = {"A": 1, "B": 2, "C": 1}
    flipped = {}
    for k, v in d.items():
        flipped.setdefault(v, []).append(k)
    print(flipped)


# 15. Vowel indices
def ex15():
    s = input("Enter a string: ")
    result = {}
    for i, c in enumerate(s):
        if c.lower() in "aeiou":
            result.setdefault(c, []).append(i)
    print(result)


